<div class="container mt-5">
  <h1>Stupid Coaching</h1>

  <blockquote class="coach-quote">
    <p><%= @question %></p>
    <footer class="blockquote-footer">You</footer>
  </blockquote>

  <blockquote class="coach-quote coach-answer">
    <p><%= @answer %></p>
    <footer class="blockquote-footer">Your coach</footer>
  </blockquote>

  <%= link_to "Ask a new question", ask_path %>
</div>
